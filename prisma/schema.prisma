generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FlightOfferRecord {
  id                     String   @id @default(cuid())
  externalId             String   @unique
  route                  String   @default("KUL-DAM")
  provider               String
  priceMYR               Float
  priceUSD               Float
  departureDate          String
  departureTime          String
  arrivalTime            String
  airlines               String[]
  flightNumbers          String[]
  transitAirports        String[]
  layoverDurationsHours  Float[]
  totalDurationHours     Float
  checkedBaggageKg       Int?
  baggageVerified        Boolean
  isSinglePNR            Boolean
  bagsRecheckRequired    Boolean
  bookingLink            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([route])
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  externalId String
  route      String   @default("KUL-DAM")
  priceMYR   Float
  observedAt DateTime @default(now())

  @@index([route])
  @@index([route, observedAt])
  @@index([externalId, observedAt])
  @@index([observedAt])
}

model NotificationLog {
  id             String   @id @default(cuid())
  route          String   @default("KUL-DAM")
  lowestPriceMYR Float
  channel        String
  reason         String
  sentAt         DateTime @default(now())

  @@index([route])
  @@index([route, sentAt])
}

model ApiUsage {
  key       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}


