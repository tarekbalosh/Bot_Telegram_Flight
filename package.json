{
  "name": "agent-ai-ticket-fly",
  "version": "1.0.0",
  "description": "Autonomous Flight Tracker Agent (KUL -> DAM)",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "run:now": "tsx src/index.ts --run-now",
    "run:once": "tsx src/index.ts --once",
    "dry-run": "tsx src/index.ts --dry-run",
    "telegram:setup": "tsx src/scripts/telegram-setup.ts",
    "db:push": "prisma db push",
    "build": "tsc",
    "start:prod": "node dist/index.js",
    "test": "tsx --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "resend": "^4.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

